{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* 运行模式配置 */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* 路径配置 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@router": ["./src/router/desktop.ts", "./src/router/mobile.ts"]
    },

    /* 核心类型支持 */
    "types": [
      "node"
    ],

    /* 严格模式与 Linting */
    "strict": true,
    "strictNullChecks": true,/*空值严格检查*/
    "noUnusedLocals": true,/*没使用的局部变量*/
    "noUnusedParameters": true,/*函数参数定义了但没使用*/
    "noFallthroughCasesInSwitch": true,/*switch 语句不写 break 就穿透到下一个 case*/
    "allowSyntheticDefaultImports": true,/*对没有 default export 的模块使用 default import*/
    "esModuleInterop": true,/*让 CommonJS 模块和 ES 模块互相导入更顺滑*/
    "forceConsistentCasingInFileNames": true /*强制文件名大小写必须统一，不允许大小写不匹配引入*/
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "src-tauri/**/*"
  ],
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}
